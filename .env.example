# Copy to .env only if you want to override the defaults.
# docker compose works without a .env file.

# Host ports (change these if something on your machine already uses them)
WEB_PORT=5173
API_PORT=3000
POSTGRES_PORT=5432

# Postgres credentials (used by the postgres container)
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp
POSTGRES_DB=erp

# Used when running the apps on your machine (pnpm dev).
# Inside Docker the API connects to host "postgres" instead of "localhost".
DATABASE_URL=postgresql://erp:erp@localhost:5432/erp

# Signs the login session cookie (at least 32 characters). The built-in default is fine for the workshop.
# AUTH_SECRET=change-me-to-a-long-random-string-0123456789

# Used only by `pnpm test:integration` (needs Postgres up). Every scenario truncates this
# database, so it must not be the dev database. Defaults to "erp_test" on the same server.
# TEST_DATABASE_URL=postgresql://erp:erp@localhost:5432/erp_test
