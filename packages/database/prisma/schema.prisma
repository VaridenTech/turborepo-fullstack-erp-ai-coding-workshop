// Prisma schema: https://www.prisma.io/docs/orm/prisma-schema
//
// Only the auth models ship with the starter. We will design the ERP data model together in the workshop.
// After adding/changing a model run:  pnpm db:migrate --name <describe-the-change>

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRATOR
  PURCHASING_OFFICER
  STORE_EMPLOYEE
  MANAGER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// Written by hashPassword() from @erp/database. Never returned by the API.
  passwordHash String
  role         Role     @default(STORE_EMPLOYEE)
  /// Store assignment (Section 2). Required for STORE_EMPLOYEE, null for other roles.
  storeId      String?
  store        Store?   @relation(fields: [storeId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Store master data (MD-03). `code` is unique; the list is ordered newest-first.
model Store {
  id                 String                    @id @default(cuid())
  code               String                    @unique
  name               String
  employees          User[]
  reorderThresholds  ProductReorderThreshold[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
}

/// Supplier master data (MD-03). `code` is unique; contact details are optional.
/// The list is ordered newest-first.
model Supplier {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Product master data (MD-01, MD-02). `sku` is unique across the organization and
/// immutable once referenced by a transaction. `sellingPrice` is money (two decimals).
/// Deactivation keeps the product searchable but blocks it from new documents.
model Product {
  id                String                    @id @default(cuid())
  sku               String                    @unique
  name              String
  category          String
  unit              String
  sellingPrice      Decimal                   @db.Decimal(12, 2)
  isActive          Boolean                   @default(true)
  reorderThresholds ProductReorderThreshold[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
}

/// Per-store reorder threshold for a product (MD-01). A product has at most one
/// threshold per store; `threshold` is a non-negative whole number.
model ProductReorderThreshold {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id])
  threshold Int

  @@unique([productId, storeId])
}
