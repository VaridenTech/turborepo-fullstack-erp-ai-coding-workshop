// Prisma schema: https://www.prisma.io/docs/orm/prisma-schema
//
// Only the auth models ship with the starter. We will design the ERP data model together in the workshop.
// After adding/changing a model run:  pnpm db:migrate --name <describe-the-change>

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRATOR
  PURCHASING_OFFICER
  STORE_EMPLOYEE
  MANAGER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// Written by hashPassword() from @erp/database. Never returned by the API.
  passwordHash String
  role         Role     @default(STORE_EMPLOYEE)
  /// Store assignment (Section 2). Required for STORE_EMPLOYEE, null for other roles.
  storeId      String?
  store        Store?   @relation(fields: [storeId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Store master data (MD-03). `code` is unique; the list is ordered newest-first.
model Store {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  employees User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
